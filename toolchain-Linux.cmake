set(CMAKE_SYSTEM_NAME      Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

find_program(CLANG_EXE    NAMES clang        REQUIRED)
find_program(CLANGXX_EXE  NAMES clang++      REQUIRED)
find_program(LLD_LINK     NAMES ld.lld       REQUIRED)
find_program(LLVM_AR      NAMES llvm-ar      REQUIRED)
find_program(LLVM_RANLIB  NAMES llvm-ranlib  REQUIRED)
find_program(LLVM_OBJCOPY NAMES llvm-objcopy REQUIRED)
find_program(LLVM_OBJDUMP NAMES llvm-objdump REQUIRED)

set(_TRIPLE "x86_64-w64-windows-gnu")

set(CMAKE_C_COMPILER          "${CLANG_EXE}")
set(CMAKE_C_COMPILER_TARGET   "${_TRIPLE}")
set(CMAKE_CXX_COMPILER        "${CLANGXX_EXE}")
set(CMAKE_CXX_COMPILER_TARGET "${_TRIPLE}")
set(CMAKE_ASM_COMPILER        "${CLANG_EXE}")
set(CMAKE_ASM_COMPILER_TARGET "${_TRIPLE}")

set(CMAKE_AR      "${LLVM_AR}")
set(CMAKE_RANLIB  "${LLVM_RANLIB}")
set(CMAKE_LINKER  "${LLD_LINK}")
set(CMAKE_OBJCOPY "${LLVM_OBJCOPY}")
set(CMAKE_OBJDUMP "${LLVM_OBJDUMP}")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE NEVER)

set(CMAKE_C_COMPILER_WORKS        TRUE CACHE BOOL "" FORCE)
set(CMAKE_CXX_COMPILER_WORKS      TRUE CACHE BOOL "" FORCE)
set(CMAKE_ASM_COMPILER_WORKS      TRUE CACHE BOOL "" FORCE)
set(CMAKE_C_COMPILER_FORCED       TRUE CACHE BOOL "" FORCE)
set(CMAKE_CXX_COMPILER_FORCED     TRUE CACHE BOOL "" FORCE)
set(CMAKE_ASM_COMPILER_FORCED     TRUE CACHE BOOL "" FORCE)

set(CMAKE_C_LINK_EXECUTABLE
    "<CMAKE_C_COMPILER> <CMAKE_C_LINK_FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>"
    CACHE STRING "" FORCE)
set(CMAKE_CXX_LINK_EXECUTABLE
    "<CMAKE_CXX_COMPILER> <CMAKE_CXX_LINK_FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>"
    CACHE STRING "" FORCE)

set(CMAKE_C_CREATE_WIN32_EXE     "" CACHE STRING "" FORCE)
set(CMAKE_C_CREATE_CONSOLE_EXE   "" CACHE STRING "" FORCE)
set(CMAKE_CXX_CREATE_WIN32_EXE   "" CACHE STRING "" FORCE)
set(CMAKE_CXX_CREATE_CONSOLE_EXE "" CACHE STRING "" FORCE)
set(CMAKE_C_STANDARD_LIBRARIES   "" CACHE STRING "" FORCE)
set(CMAKE_CXX_STANDARD_LIBRARIES "" CACHE STRING "" FORCE)